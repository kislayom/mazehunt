<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>ai.mazehunt</groupId>
        <artifactId>mazehunt-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>mazehunt-cli</artifactId>
    <name>Mazehunt :: CLI</name>

    <dependencies>
        <dependency>
            <groupId>ai.mazehunt</groupId>
            <artifactId>mazehunt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.mazehunt</groupId>
            <artifactId>mazehunt-core</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.mazehunt</groupId>
            <artifactId>mazehunt-models</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.mazehunt</groupId>
            <artifactId>mazehunt-skills</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.mazehunt</groupId>
            <artifactId>mazehunt-voice</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.mazehunt</groupId>
            <artifactId>mazehunt-vision</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>mazehunt-cli</finalName>
        <plugins>
            <plugin>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>ai.mazehunt.cli.Main</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
